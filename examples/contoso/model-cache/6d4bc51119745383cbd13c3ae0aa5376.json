      },
      {
        "element": "customerId",
        "op": "fill",
        "screen": "new-sales-order",
        "value": "$input.customerId"
      },
      {
        "element": "shipTo",
        "op": "fill",
        "screen": "new-sales-order",
        "value": "$input.shipTo"
      },
      {
        "element": "poNumber",
        "op": "fill",
        "screen": "new-sales-order",
        "value": "$input.poNumber"
      },
      {
        "element": "shipVia",
        "op": "select",
        "screen": "new-sales-order",
        "value": "$input.shipVia"
      },
      {
        "items": "$input.lines",
        "op": "forEach",
        "steps": [
          {
            "element": "product$line",
            "op": "select",
            "screen": "new-sales-order",
            "value": "$item.productId"
          },
          {
            "element": "qty$line",
            "op": "fill",
            "screen": "new-sales-order",
            "value": "$item.quantity"
          }
        ]
      },
      {
        "edge": "new-sales-order:saveOrder",
        "element": "saveOrder",
        "op": "click",
        "screen": "new-sales-order"
      },
      {
        "intent": "the new order number",
        "into": "orderNumber",
        "op": "readAfterCommit"
      }
    ]
  }
}