{
  "name": "legacylink",
  "version": "0.1.0",
  "private": true,
  "description": "Learns tasks in API-less legacy apps and compiles them into typed, self-healing MCP tools.",
  "type": "module",
  "bin": { "legacylink": "dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "legacylink": "tsx src/cli.ts",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\""
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "ajv": "8.20.0",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
